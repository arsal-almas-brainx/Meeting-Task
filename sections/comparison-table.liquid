{% comment %}
  Section contract.
  Heading, intro text and a two-column comparison table (your brand vs. others).
  Each table row is a `_comparison-row` block. On narrow screens the table keeps
  its structure and the feature column wraps.
  @example
  <!-- Add "Comparison table", set column labels, then add rows -->
{% endcomment %}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--page-width comparison-table spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --comparison-header-bg: {{ section.settings.header_background }};
    --comparison-header-text: {{ section.settings.header_text }};
    --comparison-accent: {{ section.settings.accent_color }};
  "
>
  <div class="comparison-table__inner">
    {% if section.settings.heading != blank %}
      <h2 class="comparison-table__heading h2">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="comparison-table__text">{{ section.settings.text }}</div>
    {% endif %}

    {% liquid
      assign show_table = false
      if section.blocks.size > 0 or request.design_mode
        assign show_table = true
      endif
    %}
    {% if show_table %}
      <div class="comparison-table__scroll">
        <table class="comparison-table__table">
          {% if section.settings.heading != blank %}
            <caption class="visually-hidden">{{ section.settings.heading | escape }}</caption>
          {% endif %}
          <thead>
            <tr>
              <td class="comparison-table__corner"></td>
              <th scope="col">{{ section.settings.brand_label | escape }}</th>
              <th scope="col">{{ section.settings.other_label | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {% content_for 'blocks' %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .comparison-table__inner {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .comparison-table__heading {
    margin: 0;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .comparison-table__text {
    text-align: center;
    font-size: clamp(0.875rem, 1.3vw, 1.125rem);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .comparison-table__text p {
    margin: 0;
  }

  .comparison-table__scroll {
    inline-size: 100%;
    max-inline-size: 63.75rem;
    margin-block-start: 1.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }

  .comparison-table__table {
    inline-size: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 1.125rem;
    background-color: #fff;
    color: #1a1a1a;
  }

  .comparison-table__table thead th,
  .comparison-table__corner {
    background-color: var(--comparison-header-bg);
    color: var(--comparison-header-text);
    font-weight: 600;
    padding-block: 1.25rem;
    padding-inline: 0.5rem;
  }

  .comparison-table__table thead th {
    text-align: center;
    inline-size: 20%;
  }

  .comparison-table__row + .comparison-table__row {
    border-block-start: 1px solid rgb(0 0 0 / 0.08);
  }

  .comparison-table__feature {
    padding-block: 1.3rem;
    padding-inline: 1.75rem 0.5rem;
    text-align: start;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .comparison-table__value {
    padding-block: 1.3rem;
    padding-inline: 0.5rem;
    text-align: center;
    color: rgb(0 0 0 / 0.6);
  }

  .comparison-table__value--brand {
    color: var(--comparison-accent);
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .comparison-table__table {
      font-size: 0.75rem;
    }

    .comparison-table__table thead th {
      inline-size: 24%;
    }

    .comparison-table__feature {
      padding-inline: 0.75rem 0.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.comparison_table",
  "class": "section-wrapper",
  "blocks": [{ "type": "_comparison-row" }],
  "max_blocks": 20,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Why Metanoia"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>See how we compare on what matters most when you shop.</p>"
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "t:settings.comparison_brand_label",
      "default": "Metanoia"
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "t:settings.comparison_other_label",
      "default": "Others"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "#F7F3EF"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "t:settings.comparison_header_background",
      "default": "#3B2716"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "t:settings.comparison_header_text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.comparison_accent",
      "default": "#3B2716"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:names.comparison_table",
      "category": "t:categories.text",
      "blocks": {
        "row_1": { "type": "_comparison-row", "settings": { "feature": "Virtual Try-on", "brand_value": "Yes", "other_value": "" } },
        "row_2": { "type": "_comparison-row", "settings": { "feature": "Free shipping", "brand_value": "Yes", "other_value": "Varies" } },
        "row_3": { "type": "_comparison-row", "settings": { "feature": "Easy returns", "brand_value": "Yes", "other_value": "Varies" } }
      },
      "block_order": ["row_1", "row_2", "row_3"]
    }
  ]
}
{% endschema %}
